# Copy to .env and edit if you need to. .env is gitignored; this file is committed.
# Development defaults only: weak credentials, no TLS.

# Major version of the official postgres image. Verified on 17 and 18.
# The data volume name includes this version, so switching versions gives you a
# separate, empty data directory instead of one the server cannot read.
POSTGRES_VERSION=18

# Host port, always bound to 127.0.0.1. Change it if something else already
# listens on 5432, such as a Postgres installed on the host.
POSTGRES_PORT=5432

# Superuser, its password, and the database created on first start.
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB=dev

# Size of /dev/shm in the container. Docker's 64MB default is too small for
# parallel queries.
POSTGRES_SHM_SIZE=256mb
